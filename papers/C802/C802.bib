	file = {PDF:/Users/jsmallwood/Zotero/storage/NGIQ6X58/Boonstra and Van Der Tol - 2005 - Spatial filtering of interfering signals at the initial Low Frequency Array (LOFAR) phased array tes.pdf:application/pdf},
}

