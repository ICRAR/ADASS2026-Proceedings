	file = {PDF:/Users/jsmallwood/Zotero/storage/G5KN3RZU/Sardarabadi et al. - 2016 - Spatial Filtering of RF Interference in Radio Astronomy Using a Reference Antenna Array.pdf:application/pdf},
}

