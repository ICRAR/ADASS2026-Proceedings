@article{liu_atmospheric_2021,
	title = {Atmospheric {Ducting} {Effect} in {Wireless} {Communications}: {Challenges} and {Opportunities}},
	volume = {6},
	issn = {2096-1081, 2509-3312},
	shorttitle = {Atmospheric {Ducting} {Effect} in {Wireless} {Communications}},
	url = {https://ieeexplore.ieee.org/document/9475120/},
	doi = {10.23919/JCIN.2021.9475120},
	abstract = {Atmospheric ducting has a signiﬁcant impact on electromagnetic wave propagation. Radio signals that are trapped and guided by the atmospheric duct can travel a much longer distance over the horizon with lower attenuation since the signal power does not spread isotropically through the atmosphere. Atmospheric ducting brings both challenges and opportunities to wireless communications. On one hand, the signals propagating in the atmospheric duct may interfere with a receiver far away as remote co-channel interference. On the other hand, a point-to-point link can be established directly through the atmospheric duct to enable beyond line-of-sight communications. In this article, the formation of the atmospheric duct and its effects on radio wave propagation are ﬁrst overviewed. Then solutions and standardization activities in the 3rd Generation Partnership Project (3GPP) to mitigate atmospheric duct induced remote interference are presented. Finally, the applications and design challenges of atmospheric duct enabled beyond line-of-sight communications are reviewed and future research directions are suggested.},
	language = {en},
	number = {2},
	urldate = {2025-09-01},
	journal = {Journal of Communications and Information Networks},
	author = {Liu, Fangfang and Pan, Jiaxi and Zhou, Xiangwei and Li, Geoffrey Ye},
	month = jun,
	year = {2021},
	pages = {101--109},
	file = {PDF:/Users/jsmallwood/Zotero/storage/A74V4P4E/Liu et al. - 2021 - Atmospheric Ducting Effect in Wireless Communications Challenges and Opportunities.pdf:application/pdf},
}

@inproceedings{sokolowski_statistics_2015,
