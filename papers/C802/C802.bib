@misc{ding_vlba_2024,
	title = {{VLBA} {Astrometry} of the {Fastest}-spinning {Magnetar} {Swift} {J1818}.0-1607: {A} {Large} {Trigonometric} {Distance} \& {A} {Small} {Transverse} {Velocity}},
	shorttitle = {{VLBA} {Astrometry} of the {Fastest}-spinning {Magnetar} {Swift} {J1818}.0-1607},
	url = {http://arxiv.org/abs/2406.04674},
	abstract = {In addition to being the most magnetic objects in the known universe, magnetars are the only objects observed to generate fast-radio-burst-like emissions. The formation mechanism of magnetars is still highly debated, and may potentially be probed with the magnetar velocity distribution. We carried out a 3-year-long astrometric campaign on Swift J1818.0-1607 -- the fastest-spinning magnetar, using the Very Long Baseline Array. After applying the phase-calibrating 1D interpolation strategy, we obtained a small proper motion of 8.5 \${\textbackslash}mathrm\{mas{\textasciitilde}yr{\textasciicircum}\{-1\}\}\$ magnitude, and a parallax of \$0.12{\textbackslash}pm0.02\$ mas (uncertainties at \$1{\textbackslash},{\textbackslash}sigma\$ confidence throughout the Letter) for Swift J1818.0-1607. The latter is the second magnetar parallax, and is among the smallest neutron star parallaxes ever determined. From the parallax, we derived the distance \$9.4{\textasciicircum}\{+2.0\}\_\{-1.6\}\$ kpc, which locates Swift J1818.0-1607 at the far side of the Galactic central region. Combined with the distance, the small proper motion leads to a transverse peculiar velocity \$v\_{\textbackslash}perp=48{\textasciicircum}\{+50\}\_\{-16\}\$ \${\textbackslash}mathrm\{km{\textasciitilde}s{\textasciicircum}\{-1\}\}\$ -- a new lower limit to magnetar \$v\_{\textbackslash}perp\$. Incorporating previous \$v\_{\textbackslash}perp\$ estimates of seven other magnetars, we acquired \$v\_{\textbackslash}perp=149{\textasciicircum}\{+132\}\_\{-68\}\$ \${\textbackslash}mathrm\{km{\textasciitilde}s{\textasciicircum}\{-1\}\}\$ for the sample of astrometrically studied magnetars, corresponding to the three-dimensional space velocity \${\textbackslash}sim190{\textasciicircum}\{+168\}\_\{-87\}\$ \${\textbackslash}mathrm\{km{\textasciitilde}s{\textasciicircum}\{-1\}\}\$, smaller than the average level of young pulsars. Additionally, we found that the magnetar velocity sample does not follow the unimodal young pulsar velocity distribution reported by Hobbs et al. at \${\textgreater}2{\textbackslash},{\textbackslash}sigma\$ confidence, while loosely agreeing with more recent bimodal young pulsar velocity distributions derived from relatively small samples of quality astrometric determinations.},
	language = {en},
	urldate = {2024-10-25},
	publisher = {arXiv},
	author = {Ding, Hao and Lower, Marcus E. and Deller, Adam T. and Shannon, Ryan M. and Camilo, Fernando and Sarkissian, John},
	month = jun,
	year = {2024},
	note = {arXiv:2406.04674 [astro-ph]},
	keywords = {Astrophysics - High Energy Astrophysical Phenomena},
	annote = {Comment: 13 pages, 4 figures, 4 tables, accepted for publication in ApJL},
	file = {PDF:/Users/jsmallwood/Zotero/storage/2S2GS5FG/Ding et al. - 2024 - VLBA Astrometry of the Fastest-spinning Magnetar Swift J1818.0-1607 A Large Trigonometric Distance.pdf:application/pdf},
}

