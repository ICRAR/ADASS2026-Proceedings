	pages = {6481},
	file = {PDF:/Users/jsmallwood/Zotero/storage/NAJQP534/Schirru and Gaudiomonte - 2024 - Measurement Campaign of Radio Frequency Interference in a Portion of the C-Band (4–5.8 GHz) for the.pdf:application/pdf},
}

