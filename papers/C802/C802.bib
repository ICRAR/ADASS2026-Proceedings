@misc{smallwood_spatial-filtering-rfi-mitigation_2026,
	title = {spatial-filtering-rfi-mitigation: eigen-subspace {RFI} mitigation with directional protection for the {LAMBDA} array},
	copyright = {MIT License},
	shorttitle = {spatial-filtering-rfi-mitigation},
	url = {https://zenodo.org/doi/10.5281/zenodo.22295566},
	doi = {10.5281/ZENODO.22295566},
	abstract = {Offline RFI-mitigation and imaging code for the LAMBDA 36-element radio interferometer, together with paper/paper-figures.ipynb, the notebook that regenerates every figure in Smallwood et al., Protecting astronomical sources during adaptive spatial filtering for radio frequency interference mitigation with the LAMBDA dipole array.
Short-term visibility covariances are peeled of a scaled Haslam sky prior, whitened, projected free of a fixed-rank interference subspace while protecting chosen directions (the Sun), restored, and imaged by direct DFT. A clean, RFI-free channel observed at the same time provides the reference against which mitigation is scored.
The two {\textasciitilde}10 GiB raw visibility captures the notebook consumes are archived as a separate data record; see the README for how to point \$RFI\_DATA\_PATH at them.},
	urldate = {2026-09-04},
	publisher = {Zenodo},
	author = {Smallwood, J. and Cook, Jaiden},
	month = sep,
	year = {2026},
	keywords = {eigen-subspace nulling, interferometry, LAMBDA, radio astronomy, radio frequency interference, RFI mitigation, spatial filtering},
}

